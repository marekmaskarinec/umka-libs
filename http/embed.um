
import (
    "std.um"
)

fn main() {
    fname := std.argv(1)
    aname := std.argv(2)
    
    f := std.fopen(fname, "rb")
    std.fseek(f, 0, std.seekEnd)
    size := std.ftell(f)
    std.fseek(f, 0, std.seekBegin)

    inp := make([]uint8, size)
    std.fread(f, inp)
    
    std.fclose(f)

    f = std.fopen(fname+".h", "wb")

    fprintf(f, "#ifndef %s_H_\n", aname)
    fprintf(f, "#define %s_H_\n", aname)
    fprintf(f, "#include <stdint.h>\n")
    fprintf(f, "const uint8_t %s[%d] = {\n", aname, size)
    for i,b in inp {
        fprintf(f, "0x%02x,", b)
    }
           
    fprintf(f, "\n};\n")
    fprintf(f, "#endif\n")

    std.fclose(f)
}
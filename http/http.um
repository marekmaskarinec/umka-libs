
import (
    "umbox/io/io.um"
    "std.um"
)

//~~struct Response
// Http response struct.
type Response* = struct {
    ok: bool         // true if the request was successful
    err: str         // error message if the request failed
    status: int      // HTTP status code
    contentType: str // response content type
}
//~~

//~~struct GetParams
// Optional parameters for the `get` function.
type GetParams* = struct {
    userAgent: str
    headers: []str
}
//~~

fn umc__get(url: str, params: ^GetParams, resp: ^Response, out: ^io.Writer)

//~~fn get
// Make a GET request.
fn get*(url: str, out: io.Writer, params: GetParams = {}): Response {
//~~
    resp := Response{}
    umc__get(url, &params, &resp, &out)
    return resp
}

//~~fn encodeUrl
// Encode a URL with query parameters.
fn encodeUrl*(url: str, args: map[str]any): str {
//~~
    url += "?"
    for k,v in args {
        s := sprintf("%v", v)
        if ^str(v) != null {
            s = str(v)
        }
        url += str(k) + "=" + s + "&"
    }
    
    return slice(url, 0, len(url)-1) // remove last &
}

//~~struct PostParams
// Optional parameters for the `post` function.
type PostParams* = struct {
    userAgent: str
    headers: []str
}
//~~

fn umc__post(url: str, params: ^PostParams, out: ^Response, r: ^io.Reader, w: ^io.Writer)
    
//~~fn post
// Make a POST request.
fn post*(url: str, inp: io.Reader, out: io.Writer, params: PostParams = {}): Response {
//~~
    resp := Response{}
    umc__post(url, &params, &resp, &inp, &out)
    return resp
}

//~~Example
fn main() {
    dat := io.mkMemory({})
    resp := get(
        encodeUrl("https://httpbin.org/get", {
            "foo": "bar",
            "baz": 42
        }),
        dat,
        {
            userAgent: "my user agent"
        }
    )

    printf("Ok: %v\n", resp.ok)
    printf("Error: %v\n", resp.err)
    printf("Code: %v\n", resp.status)
    printf("Content type: %v\n", resp.contentType)
    printf("Body: %v\n", str([]char(dat.read())))
    
    f := std.fopen("out", "w")
    dat = io.mkFile(f)
    get("https://httpbin.org/get", dat)
    std.fclose(f)
    
    dat = io.mkMemory({})
    resp = post(
        "https://httpbin.org/post",
        io.mkMemory([]uint8([]char("Hello world!"))),
        dat,
        {
            userAgent: "my user agent",
            headers: { "Content-Type: text/plain" }
        }
    ) 

    printf("Ok: %v\n", resp.ok)
    printf("Error: %v\n", resp.err)
    printf("Code: %v\n", resp.status)
    printf("Content type: %v\n", resp.contentType)
    printf("Body: %v\n", str([]char(dat.read())))
}
//~~
